# Standardise category labels
for (v in names(canonical)) {
if (!(v %in% names(data_clean))) next  # Skip if variable doesn't exist
before <- data_clean[[v]]
key <- tolower(trimws(before))
if (v == "VehicleType") key[key == "sport"] <- "sports"
after <- canonical[[v]][match(key, tolower(canonical[[v]]))]
bad <- !is.na(before) & is.na(after)
if (any(bad)) {
stop(sprintf("%s: Unrecognised labels in %s: %s", year_name, v,
paste(unique(before[bad]), collapse = ", ")))
}
changed <- sum(!is.na(before) & before != after)
if (changed > 0) {
cat(sprintf("[%s] Standardised %d category labels in %s\n", year_name, changed, v))
}
data_clean[, (v) := after]
}
# Check for impossible/invalid values
bad_age <- which(!is.na(data_clean$DriverAge) & (data_clean$DriverAge < 17 | data_clean$DriverAge > 100))
if (length(bad_age) > 0) {
cat(sprintf("[%s] WARNING: %d records with invalid DriverAge (outside 17–100)\n",
year_name, length(bad_age)))
data_clean[bad_age, DriverAge := NA_real_]
}
bad_veh <- which(!is.na(data_clean$VehAge) & data_clean$VehAge < 0)
if (length(bad_veh) > 0) {
cat(sprintf("[%s] WARNING: %d records with negative VehAge\n", year_name, length(bad_veh)))
data_clean[bad_veh, VehAge := NA_real_]
}
bad_exc <- which(!is.na(data_clean$ExcessChosen) & !(data_clean$ExcessChosen %in% c(500, 750, 1000)))
if (length(bad_exc) > 0) {
cat(sprintf("[%s] WARNING: %d records with invalid ExcessChosen\n", year_name, length(bad_exc)))
data_clean[bad_exc, ExcessChosen := NA_real_]
}
# Check for missing values
missing_check <- data_clean[, lapply(.SD, function(x) sum(is.na(x)))]
missing_cols <- names(missing_check)[missing_check > 0]
if (length(missing_cols) > 0) {
cat(sprintf("[%s] Missing values detected:\n", year_name))
for (col in missing_cols) {
pct <- round(100 * missing_check[[col]] / nrow(data_clean), 2)
cat(sprintf("  - %s: %d rows (%.2f%%)\n", col, missing_check[[col]], pct))
}
} else {
cat(sprintf("[%s] No missing values detected ✓\n", year_name))
}
# Validation checks
validation_checks <- list(
"PolicyID not in POL###### format" = data_clean[!grepl("^POL[0-9]{6}$", PolicyID), .N],
"DriverAge outside 17–100" = data_clean[!is.na(DriverAge) & (DriverAge < 17 | DriverAge > 100), .N],
"VehAge < 0" = data_clean[!is.na(VehAge) & VehAge < 0, .N],
"ExcessChosen not in {500,750,1000}" = data_clean[!is.na(ExcessChosen) &
!(ExcessChosen %in% c(500, 750, 1000)), .N],
"VehValue <= 0" = data_clean[!is.na(VehValue) & VehValue <= 0, .N],
"TenureYears < 0" = data_clean[TenureYears < 0, .N],
"NCDLevel outside 0–6" = data_clean[NCDLevel < 0 | NCDLevel > 6, .N],
"Duplicate PolicyID" = data_clean[, sum(duplicated(PolicyID))]
)
validation_results <- data.table(
Check = names(validation_checks),
Failures = unlist(validation_checks)
)
cat(sprintf("\n[%s] Validation checks:\n", year_name))
print(validation_results[Failures > 0])
if (validation_results[, all(Failures == 0)]) {
cat(sprintf("[%s] All validation checks passed ✓\n", year_name))
}
# Convert to factors
data_clean[, `:=`(
VehicleType = factor(VehicleType, canonical$VehicleType),
RiskZone = factor(RiskZone, canonical$RiskZone),
AnnualKms = factor(AnnualKms, canonical$AnnualKms),
GaragingLocation = factor(GaragingLocation, canonical$GaragingLocation),
VehicleUse = factor(VehicleUse, canonical$VehicleUse),
PaymentFrequency = factor(PaymentFrequency, canonical$PaymentFrequency),
ExcessChosen = as.integer(ExcessChosen),
DriverAge = as.integer(DriverAge),
VehAge = as.integer(VehAge)
)]
cat(sprintf("[%s] Converted to appropriate data types ✓\n", year_name))
cat(sprintf("[%s] Final: %d rows × %d columns\n\n", year_name, nrow(data_clean), ncol(data_clean)))
return(data_clean)
}
# Apply to both renewal books
renewal_book_2027_clean <- clean_renewal_book(renewal_book_2027, "Renewal Book 2027")
# 4. Clean renewal books 2027 and 2028 ----------------------------------------
clean_renewal_book <- function(renewal_data, year_name) {
data_clean <- copy(renewal_data)
# Convert numeric columns
num_cols <- c("DriverAge", "YearsLicensed", "VehAge", "VehValue")
data_clean[, (num_cols) := lapply(.SD, as.numeric), .SDcols = num_cols]
# Standardise category labels
for (v in names(canonical)) {
if (!(v %in% names(data_clean))) next
before <- data_clean[[v]]
key <- tolower(trimws(before))
if (v == "VehicleType") key[key == "sport"] <- "sports"
after <- canonical[[v]][match(key, tolower(canonical[[v]]))]
bad <- !is.na(before) & is.na(after)
if (any(bad)) {
stop(sprintf("Unrecognised labels in %s: %s", v, paste(unique(before[bad]), collapse = ", ")))
}
data_clean[, (v) := after]
}
# Check for invalid values
bad_age <- which(!is.na(data_clean$DriverAge) & (data_clean$DriverAge < 17 | data_clean$DriverAge > 100))
bad_veh <- which(!is.na(data_clean$VehAge) & data_clean$VehAge < 0)
bad_exc <- which(!is.na(data_clean$ExcessChosen) & !(data_clean$ExcessChosen %in% c(500, 750, 1000)))
if (length(bad_age) > 0) data_clean[bad_age, DriverAge := NA_real_]
if (length(bad_veh) > 0) data_clean[bad_veh, VehAge := NA_real_]
if (length(bad_exc) > 0) data_clean[bad_exc, ExcessChosen := NA_real_]
# Convert to factors
data_clean[, `:=`(
VehicleType = factor(VehicleType, canonical$VehicleType),
RiskZone = factor(RiskZone, canonical$RiskZone),
AnnualKms = factor(AnnualKms, canonical$AnnualKms),
GaragingLocation = factor(GaragingLocation, canonical$GaragingLocation),
VehicleUse = factor(VehicleUse, canonical$VehicleUse),
PaymentFrequency = factor(PaymentFrequency, canonical$PaymentFrequency),
ExcessChosen = as.integer(ExcessChosen),
DriverAge = as.integer(DriverAge),
VehAge = as.integer(VehAge)
)]
# Validation checks
checks <- list(
"Duplicate PolicyID" = data_clean[, sum(duplicated(PolicyID))],
"Invalid DriverAge" = length(which(!is.na(data_clean$DriverAge) &
(data_clean$DriverAge < 17 | data_clean$DriverAge > 100))),
"Invalid VehAge" = length(which(!is.na(data_clean$VehAge) & data_clean$VehAge < 0)),
"Invalid ExcessChosen" = length(which(!is.na(data_clean$ExcessChosen) &
!(data_clean$ExcessChosen %in% c(500, 750, 1000)))),
"NCDLevel outside 0–6" = data_clean[NCDLevel < 0 | NCDLevel > 6, .N],
"TenureYears < 0" = data_clean[TenureYears < 0, .N]
)
failures <- data.table(Check = names(checks), Failures = unlist(checks))
if (failures[, any(Failures > 0)]) {
cat(sprintf("\n%s Validation Issues:\n", year_name))
print(failures[Failures > 0])
} else {
cat(sprintf("\n%s: All validation checks passed ✓\n", year_name))
}
cat(sprintf("  %d policies × %d columns\n", nrow(data_clean), ncol(data_clean)))
return(data_clean)
}
# Clean both renewal books
